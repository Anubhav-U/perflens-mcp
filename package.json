{
  "name": "perflens-mcp",
  "version": "0.1.2",
  "description": "MCP server that runs Lighthouse performance audits from Claude Code, Cursor and other AI coding tools.",
  "type": "module",
  "bin": {
    "perflens-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "precompute": "tsx scripts/precompute-site.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lighthouse",
    "performance",
    "core-web-vitals",
    "claude",
    "cursor"
  ],
  "author": "Anubhav Utkarsh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anubhav-U/perflens-mcp.git"
  },
  "homepage": "https://perflens-mcp.vercel.app",
  "bugs": {
    "url": "https://github.com/Anubhav-U/perflens-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^12.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
